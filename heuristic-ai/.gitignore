# HeuristicAI — Project .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
.expo-shared/
dist/
web-build/
build/
.cache/

# Native builds
# (If they are generated and not intentionally maintained, ignore them)
# Actually, the user says "If android/ and ios/ are generated and not intentionally maintained, ignore them. If they are intentionally part of the project, do not ignore them."
# I will ignore them as they are usually auto-generated by Expo unless prebuild is used. Since this is an expo project (Expo SDK 56) with app.json, ios/ and android/ are usually generated. I will ignore them for now.
ios/
android/

# Environment variables (never commit)
.env
.env.*
!.env.example

# Private Credentials & Keys
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# Build artifacts
*.jsbundle
*.hbc

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Jest coverage
coverage/
.nyc_output/

# TypeScript build info
*.tsbuildinfo

# Temporary files
*.tmp
*.temp

# MediaPipe models
assets/models/*.task
assets/models/*.bin
assets/models/*.tflite

expo-env.d.ts